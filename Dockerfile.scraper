FROM python:3.13.5-slim-bookworm AS scraper

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

COPY requirements.txt /app/requirements.txt
COPY requirements-scraper.txt /app/requirements-scraper.txt

RUN python -m pip install --no-cache-dir -r requirements.txt -r requirements-scraper.txt \
    && python -m playwright install --with-deps chromium \
    && useradd --system --uid 10001 --create-home app \
    && mkdir -p /browser-profile \
    && chown -R 10001:10001 /browser-profile \
    && chmod -R a+rX /ms-playwright

COPY flat_detector /app/flat_detector

USER 10001:10001
ENTRYPOINT ["python", "-m", "flat_detector.avito_browser"]
