# Copy to .env and create BOTH DB/app copies of the same generated password:
# deploy/secrets/postgres_password_app (mode 0400; owner 10001)
# deploy/secrets/postgres_password_db (mode 0400; owner image's postgres UID)
# Keep deploy/secrets root-owned 0700; never commit either file.
# Never commit token, password, subscriber database, or production snapshots.
FD_DEMO_MODE=false
FD_DEMO_DELIVERY=false
# Telegram token: deploy/secrets/telegram_token file, only after explicit consent to pilot.
# MCP has NO public auth: see DEPLOYMENT.md. Never publish port 8765.
# Optional, disabled-by-default approved JSON feed: only after verified partner permission.
# FD_FEED_SOURCE_KEY=approved_partner
# FD_FEED_URL=https://partner.example.org/api/v1/flats
# FD_FEED_ORIGIN=https://partner.example.org
# FD_FEED_POLL_SECONDS=86400
# MCP explicit Host allowlist contains only 127.0.0.1:8765 and localhost:8765 by default.
# FD_MCP_ALLOWED_HOSTS=mcp.example.org
# FD_MCP_ALLOWED_ORIGINS=https://example.org
